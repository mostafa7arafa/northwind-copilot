# Copy to deploy/.env and fill in before `docker compose up`.
# Generate secrets with, e.g.:
#   JWT_SECRET:            openssl rand -hex 32
#   KEY_ENCRYPTION_SECRET: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Domain / TLS --------------------------------------------------------
# The public hostname Caddy serves and gets a certificate for.
SITE_ADDRESS=your-domain.com
FRONTEND_ORIGIN=https://your-domain.com

# --- Postgres ------------------------------------------------------------
POSTGRES_USER=copilot
POSTGRES_PASSWORD=
POSTGRES_DB=copilot

# --- Secrets (required) --------------------------------------------------
JWT_SECRET=
KEY_ENCRYPTION_SECRET=

# --- LLM (our metered key + optional fallback) ---------------------------
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Google OAuth (optional) --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Build behind a TLS-intercepting network (optional) -----------------
# If `docker compose build` fails with certificate errors ("UnknownIssuer" /
# "unable to verify the first certificate"), your network (corporate proxy or
# some antivirus) re-signs HTTPS. Set this to 1 to skip cert verification while
# fetching packages/fonts during the BUILD only. Safe: uv.lock and
# package-lock.json pin hashes, so package integrity is still verified. Leave
# empty on a clean network (e.g. your production server).
INSECURE_TLS=
