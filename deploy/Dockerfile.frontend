# Frontend image: Next.js 15 built to a standalone server bundle.
#
# Multi-stage: install deps, build, then copy only the standalone output into a
# slim runtime image (no full node_modules, no build toolchain).
FROM node:20-slim AS deps
WORKDIR /app
# Opt-in escape hatch for TLS-intercepting networks (see Dockerfile.backend).
# Safe because package-lock.json pins integrity hashes; only the cert check is
# relaxed. Off by default.
ARG INSECURE_TLS=""
RUN if [ -n "$INSECURE_TLS" ]; then npm config set strict-ssl false; fi
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install

FROM node:20-slim AS builder
WORKDIR /app
# Same opt-in as the deps stage. `next/font/google` fetches fonts at build time
# via Node's own TLS (not npm), so on an intercepting network we also relax
# Node's cert check for this build step only.
ARG INSECURE_TLS=""
COPY --from=deps /app/node_modules ./node_modules
COPY frontend ./
# NEXT_PUBLIC_* are inlined at build time; the API base is same-origin in prod
# (Caddy proxies /api/*), so nothing secret is baked in here. HOSTED_MODE turns
# on the auth gate + dataset manager, so it MUST be present during the build —
# a runtime env var would be ignored by the already-built bundle.
ARG NEXT_PUBLIC_HOSTED_MODE=""
ENV NEXT_PUBLIC_HOSTED_MODE=$NEXT_PUBLIC_HOSTED_MODE
# Browser-side Sentry: a DSN is not a secret (it can only ingest events), but
# it is inlined at build time like every NEXT_PUBLIC_* value.
ARG NEXT_PUBLIC_SENTRY_DSN=""
ARG NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_PUBLIC_SENTRY_ENVIRONMENT=$NEXT_PUBLIC_SENTRY_ENVIRONMENT
RUN if [ -n "$INSECURE_TLS" ]; then export NODE_TLS_REJECT_UNAUTHORIZED=0; fi; \
    npm run build

FROM node:20-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000
# Standalone output bundles a minimal server.js + traced node_modules.
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
