[flake8]
max-line-length = 88
# E203 (whitespace before ':') and W503 (line break before binary operator)
# conflict with black's formatting; E704 too. Ignore per black's guidance.
extend-ignore = E203, W503, E704
exclude =
    .venv,
    .git,
    __pycache__,
    .langgraph_api,
    eval/results,
    build,
    dist
