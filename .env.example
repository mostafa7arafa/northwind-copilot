# Copy to .env and fill in as needed. All values are optional — the app falls
# back to the defaults in northwind_copilot/core/config.py.

# --- Models --------------------------------------------------------------
# Local-first primary (must be pulled in your Ollama). Escalates to the cloud
# FALLBACK_MODEL only on an error or an empty response — and only if a key is set.
PRIMARY_MODEL=gemma4-12b
FALLBACK_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Enables the cloud fallback AND the RAG `search_docs` tool (OpenAI embeddings).
# Leave blank to run fully local (no fallback, no doc search).
OPENAI_API_KEY=

# --- Data & knowledge base ----------------------------------------------
# NB: NOT "DATABASE_URI" — LangGraph reserves that name and overwrites it with
# ":memory:" under `langgraph dev`.
NORTHWIND_DATABASE_URI=sqlite:///data/northwind.sqlite
DOCS_DIR=docs
FAISS_PATH=.faiss_index
# Set to true to rebuild the FAISS index on next load.
REINDEX=false

# --- Web service / deployment -------------------------------------------
# Base URL of the Ollama daemon. In docker-compose this is usually the service
# name, e.g. http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434
# Comma-separated browser origins allowed to call the API (CORS). Set this to
# your real frontend origin in production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional shared bearer token. When set, every API request must send
# `Authorization: Bearer <token>`. Leave blank for an open, single-user POC.
# NB: while this is blank the server will NOT spend its own OPENAI_API_KEY for a
# caller who didn't supply their own key — set a token to enable that.
APP_AUTH_TOKEN=

# --- Abuse / cost guards ------------------------------------------------
# Max /api/chat requests per client IP per minute (0 disables).
RATE_LIMIT_PER_MINUTE=20
# Wall-clock budget (seconds) for one analyst turn before it is stopped.
TURN_DEADLINE_SECONDS=120
# Wall-clock budget (seconds) for a single result SQL run.
QUERY_TIMEOUT_SECONDS=10
# Input caps for one request.
MAX_MESSAGES=40
MAX_MESSAGE_CHARS=8000
MAX_PREFERENCES_CHARS=4000

# --- Optional: LangSmith tracing ----------------------------------------
# Privacy note: when tracing is ON, prompts and query results (i.e. your data)
# are sent to LangSmith. For a self-hosted deployment keep this OFF unless you
# accept that. Set LANGCHAIN_TRACING_V2=false to silence tracing.
LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=northwind-copilot
