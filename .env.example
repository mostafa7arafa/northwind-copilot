# Copy to .env and fill in as needed. All values are optional — the app falls
# back to the defaults in northwind_copilot/core/config.py.

# --- Models --------------------------------------------------------------
# Local-first primary (must be pulled in your Ollama). Escalates to the cloud
# FALLBACK_MODEL only on an error or an empty response — and only if a key is set.
PRIMARY_MODEL=gemma4-12b
FALLBACK_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Enables the cloud fallback AND the RAG `search_docs` tool (OpenAI embeddings).
# Leave blank to run fully local (no fallback, no doc search).
OPENAI_API_KEY=

# --- Data & knowledge base ----------------------------------------------
# NB: NOT "DATABASE_URI" — LangGraph reserves that name and overwrites it with
# ":memory:" under `langgraph dev`.
NORTHWIND_DATABASE_URI=sqlite:///data/northwind.sqlite
DOCS_DIR=docs
FAISS_PATH=.faiss_index
# Set to true to rebuild the FAISS index on next load.
REINDEX=false

# --- Optional: LangSmith tracing ----------------------------------------
# Set LANGCHAIN_TRACING_V2=false to silence tracing if you don't use it.
LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=northwind-copilot
