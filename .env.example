# Optional: copy to .env. ./dev.sh works with defaults; select a model in the UI.
# Personal, loopback-only app. No accounts, subscriptions, or hosted mode.

# --- Models --------------------------------------------------------------
PRIMARY_MODEL=gemma4-12b
FALLBACK_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
# Server-side cloud keys; never sent back to the browser.
# OpenAI also supplies embeddings for the optional search_docs tool.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Local data ----------------------------------------------------------
# Do not use DATABASE_URI: LangGraph reserves that name.
NORTHWIND_DATABASE_URI=sqlite:///data/northwind.sqlite
WORKSPACE_DATABASE_URL=sqlite+aiosqlite:///data/workspace.sqlite
DATASET_DATA_DIR=data/datasets
DOCS_DIR=docs
FAISS_PATH=.faiss_index
REINDEX=false

# Allowed browser origins must be loopback. Never expose this app publicly.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Safety / resource limits --------------------------------------------
RATE_LIMIT_PER_MINUTE=20
TURN_DEADLINE_SECONDS=120
TURN_DEADLINE_SECONDS_CLOUD=300
QUERY_TIMEOUT_SECONDS=10
MAX_MESSAGES=40
MAX_MESSAGE_CHARS=8000
MAX_PREFERENCES_CHARS=4000

# --- Optional tracing / error reporting ----------------------------------
# Opt in only if you accept sending prompts/results or errors to a third party.
# Explicit LangSmith callbacks use LANGSMITH_API_KEY; leave it unset to disable.
LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=northwind-copilot
# SENTRY_DSN=
# Never enable INSECURE_TLS except for a deliberate local TLS debugging session.
