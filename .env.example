# Copy to .env and fill in your values. .env is gitignored.

# Required: used for the GPT-4.1 fallback model and for RAG embeddings.
OPENAI_API_KEY=

# Optional: LangSmith tracing.
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=northwind-copilot

# Rebuild the FAISS doc index on next run (set false once built).
REINDEX=true
